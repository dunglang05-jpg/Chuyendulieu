{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PTP/1 QR session payload (decoded d= parameter)",
  "type": "object",
  "required": [
    "v",
    "sid",
    "exp",
    "ep",
    "fp",
    "role",
    "pf"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1
    },
    "sid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "exp": {
      "type": "integer"
    },
    "ep": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "fp": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "role": {
      "enum": [
        "sender",
        "receiver"
      ]
    },
    "pf": {
      "enum": [
        "android",
        "ios",
        "desktop_reference"
      ]
    },
    "f": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 32
      }
    },
    "ap": {
      "description": "Optional: host's app-only hotspot (Android LocalOnlyHotspot) for direct phone-to-phone Wi-Fi. Ephemeral, system-generated; shown on screen only, never logged.",
      "type": "object",
      "additionalProperties": false,
      "required": ["s", "k", "sec"],
      "properties": {
        "s": {"type": "string", "minLength": 1, "maxLength": 32},
        "k": {"type": "string", "minLength": 8, "maxLength": 63, "pattern": "^[\\x20-\\x7e]+$"},
        "sec": {"enum": ["wpa2", "wpa3"]},
        "m": {"description": "p2p = Wi-Fi Direct group, ap = local-only hotspot", "enum": ["p2p", "ap"]},
        "b": {"description": "band of the link: 5 GHz, 2.4 GHz or unknown", "enum": ["5", "2", "a"]}
      }
    }
  }
}
