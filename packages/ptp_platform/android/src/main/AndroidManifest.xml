<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- LAN transfer (no Internet service is contacted) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Media read, requested in context only when the user selects the category -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Contacts export only; import goes through the system Contacts app (official flow) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Keep the transfer alive while the screen is off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Asks once (system dialog) to leave battery optimisation, so Doze does not cut the Wi-Fi link while the
         screen is off during a transfer. The user can refuse; the transfer then relies on the foreground service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- "Điểm phát": app-only hotspot on the host, direct Wi-Fi join on the other phone. No Internet sharing and no
         location use (neverForLocation); API 29-32 still require the location permission for these Wi-Fi APIs. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />

    <!-- "Ứng dụng" (Android → Android): list the user's installed apps and read their APK files (never app data);
         on the receiver, install them through the system installer, which asks the user for every app.
         QUERY_ALL_PACKAGES is restricted on Google Play: a Play build must justify it or drop this category. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- "Toàn bộ tệp" (Android 11+): read every non-media file in shared storage after the user turns on
         "All files access" in Settings. Restricted on Google Play like QUERY_ALL_PACKAGES. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Optional: the USB-C cable mode needs host or accessory support, but the app must stay installable
         without it (Wi-Fi is the default transport). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />

    <application>
        <!-- USB cable mode: lets the user pick this app in the system "USB device/accessory attached" sheet, which
             grants the USB permission. Invisible; brings the app to the front and finishes. -->
        <activity
            android:name="com.phonetransferpro.ptp_platform.usb.UsbAttachActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/ptp_usb_device_filter" />
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/ptp_usb_accessory_filter" />
        </activity>
        <service
            android:name="com.phonetransferpro.ptp_platform.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ptp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ptp_file_paths" />
        </provider>
    </application>
</manifest>
